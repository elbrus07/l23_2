#include <gtkmm.h>
#include <fstream>
#include <regex>
#include <string>
#include <cctype>

class NotesProgram : public Gtk::Window
{
private:
    Gtk::Box mainBox{Gtk::ORIENTATION_VERTICAL};
    Gtk::Box topButtons{Gtk::ORIENTATION_HORIZONTAL};
    Gtk::Box fontButtons{Gtk::ORIENTATION_HORIZONTAL};

    Gtk::Button createButton{"Новый"};
    Gtk::Button openButton{"Открыть"};
    Gtk::Button saveButton{"Сохранить"};

    Gtk::Button chooseFontButton{"Шрифт"};
    Gtk::Button biggerFontButton{"+"};
    Gtk::Button smallerFontButton{"-"};

    Gtk::Label currentFileLabel;
    Gtk::Label statusLabel;
    Gtk::Label fontLabel;

    Gtk::ScrolledWindow scrollArea;
    Gtk::TextView textField;

    std::string openedFile;
    std::string selectedFont = "Sans";
    int fontSize = 12;

private:

    void setTextFont()
    {
        auto buffer = textField.get_buffer();

        Gtk::TextBuffer::iterator begin, finish;
        buffer->get_bounds(begin, finish);

        auto table = buffer->get_tag_table();
        auto tag = table->lookup("text_font");

        if (!tag)
        {
            tag = Gtk::TextBuffer::Tag::create("text_font");
            table->add(tag);
        }

        std::string fontData =
            selectedFont + " " + std::to_string(fontSize);

        tag->property_font() = fontData;

        buffer->apply_tag(tag, begin, finish);
    }

    void paintWords()
    {
        auto buffer = textField.get_buffer();

        Gtk::TextBuffer::iterator begin, finish;
        buffer->get_bounds(begin, finish);

        std::string text = buffer->get_text();

        std::regex expression(R"([а-яА-Яa-zA-Z]+)");
        std::smatch found;

        auto table = buffer->get_tag_table();

        auto createTag = [&](std::string name,
                             std::string color)
        {
            auto tag = table->lookup(name);

            if (!tag)
            {
                tag = Gtk::TextBuffer::Tag::create(name);
                tag->property_foreground() = color;
                table->add(tag);
            }

            return tag;
        };

        auto red = createTag("r", "red");
        auto blue = createTag("b", "blue");
        auto green = createTag("g", "green");
        auto yellow = createTag("y", "yellow");
        auto cyan = createTag("c", "cyan");
        auto orange = createTag("o", "orange");
        auto gray = createTag("gr", "gray");

        buffer->remove_all_tags(begin, finish);

        std::string::const_iterator search(text.cbegin());

        while (std::regex_search(search,
                                 text.cend(),
                                 found,
                                 expression))
        {
            std::string word = found[0];

            if (!word.empty())
            {
                char first =
                    std::tolower(word[0]);

                int startPos = found.position();
                int length = found.length();

                auto wordStart =
                    buffer->get_iter_at_offset(startPos);

                auto wordEnd =
                    buffer->get_iter_at_offset(startPos + length);

                if (first == 'к')
                    buffer->apply_tag(red, wordStart, wordEnd);

                else if (first == 'с')
                    buffer->apply_tag(blue, wordStart, wordEnd);

                else if (first == 'з')
                    buffer->apply_tag(green, wordStart, wordEnd);

                else if (first == 'ж')
                    buffer->apply_tag(yellow, wordStart, wordEnd);

                else if (first == 'г')
                    buffer->apply_tag(cyan, wordStart, wordEnd);

                else if (first == 'о')
                    buffer->apply_tag(orange, wordStart, wordEnd);

                else if (first == 'ч' || first == 'б')
                    buffer->apply_tag(gray, wordStart, wordEnd);
            }

            search = found.suffix().first;
        }

        setTextFont();
    }

    void chooseFont()
    {
        Gtk::FontChooserDialog dialog(
            *this,
            "Выбор шрифта",
            true
        );

        dialog.set_font(
            selectedFont + " " +
            std::to_string(fontSize)
        );

        int result = dialog.run();

        if (result == Gtk::RESPONSE_OK)
        {
            std::string font =
                dialog.get_font();

            size_t pos =
                font.find_last_of(' ');

            if (pos != std::string::npos)
            {
                selectedFont =
                    font.substr(0, pos);

                fontSize =
                    std::stoi(font.substr(pos + 1));

                fontLabel.set_text(
                    "Шрифт: " +
                    selectedFont +
                    " " +
                    std::to_string(fontSize)
                );

                setTextFont();

                statusLabel.set_text(
                    "Шрифт изменён"
                );
            }
        }
    }

    void increaseFont()
    {
        fontSize += 2;

        if (fontSize > 72)
            fontSize = 72;

        setTextFont();

        fontLabel.set_text(
            "Шрифт: " +
            selectedFont +
            " " +
            std::to_string(fontSize)
        );

        statusLabel.set_text(
            "Размер увеличен"
        );
    }

    void decreaseFont()
    {
        fontSize -= 2;

        if (fontSize < 8)
            fontSize = 8;

        setTextFont();

        fontLabel.set_text(
            "Шрифт: " +
            selectedFont +
            " " +
            std::to_string(fontSize)
        );

        statusLabel.set_text(
            "Размер уменьшен"
        );
    }

    void createNewFile()
    {
        textField.get_buffer()->set_text("");

        openedFile.clear();

        currentFileLabel.set_text(
            "Новый документ"
        );

        statusLabel.set_text(
            "Создан новый файл"
        );
    }

    void openFile()
    {
        Gtk::FileChooserDialog dialog(
            *this,
            "Открыть файл",
            Gtk::FILE_CHOOSER_ACTION_OPEN
        );

        dialog.add_button(
            "Отмена",
            Gtk::RESPONSE_CANCEL
        );

        dialog.add_button(
            "Открыть",
            Gtk::RESPONSE_OK
        );

        if (dialog.run() == Gtk::RESPONSE_OK)
        {
            std::ifstream file(
                dialog.get_filename()
            );

            if (file)
            {
                std::string line;
                std::string text;

                while (getline(file, line))
                {
                    text += line + "\n";
                }

                textField
                    .get_buffer()
                    ->set_text(text);

                openedFile =
                    dialog.get_filename();

                currentFileLabel.set_text(
                    "Файл: " + openedFile
                );

                statusLabel.set_text(
                    "Файл открыт"
                );
            }
            else
            {
                statusLabel.set_text(
                    "Ошибка открытия"
                );
            }
        }
    }

    void saveFile()
    {
        Gtk::FileChooserDialog dialog(
            *this,
            "Сохранить файл",
            Gtk::FILE_CHOOSER_ACTION_SAVE
        );

        dialog.add_button(
            "Отмена",
            Gtk::RESPONSE_CANCEL
        );

        dialog.add_button(
            "Сохранить",
            Gtk::RESPONSE_OK
        );

        if (dialog.run() == Gtk::RESPONSE_OK)
        {
            std::ofstream file(
                dialog.get_filename()
            );

            if (file)
            {
                file <<
                    textField
                    .get_buffer()
                    ->get_text();

                openedFile =
                    dialog.get_filename();

                currentFileLabel.set_text(
                    "Файл: " + openedFile
                );

                statusLabel.set_text(
                    "Файл сохранён"
                );
            }
            else
            {
                statusLabel.set_text(
                    "Ошибка сохранения"
                );
            }
        }
    }

public:
    NotesProgram()
    {
        set_title("Текстовый редактор");
        set_default_size(700, 600);

        mainBox.set_spacing(5);
        topButtons.set_spacing(8);
        fontButtons.set_spacing(8);

        topButtons.pack_start(
            createButton,
            Gtk::PACK_SHRINK
        );

        topButtons.pack_start(
            openButton,
            Gtk::PACK_SHRINK
        );

        topButtons.pack_start(
            saveButton,
            Gtk::PACK_SHRINK
        );

        fontButtons.pack_start(
            chooseFontButton,
            Gtk::PACK_SHRINK
        );

        fontButtons.pack_start(
            biggerFontButton,
            Gtk::PACK_SHRINK
        );

        fontButtons.pack_start(
            smallerFontButton,
            Gtk::PACK_SHRINK
        );

        mainBox.pack_start(
            topButtons,
            Gtk::PACK_SHRINK
        );

        mainBox.pack_start(
            fontButtons,
            Gtk::PACK_SHRINK
        );

        fontLabel.set_text(
            "Шрифт: Sans 12"
        );

        currentFileLabel.set_text(
            "Файл не открыт"
        );

        statusLabel.set_text(
            "Готово"
        );

        mainBox.pack_start(
            fontLabel,
            Gtk::PACK_SHRINK
        );

        mainBox.pack_start(
            currentFileLabel,
            Gtk::PACK_SHRINK
        );

        scrollArea.add(textField);

        scrollArea.set_policy(
            Gtk::POLICY_AUTOMATIC,
            Gtk::POLICY_AUTOMATIC
        );

        mainBox.pack_start(scrollArea);

        mainBox.pack_start(
            statusLabel,
            Gtk::PACK_SHRINK
        );

        add(mainBox);

        createButton.signal_clicked()
            .connect(sigc::mem_fun(
                *this,
                &NotesProgram::createNewFile
            ));

        openButton.signal_clicked()
            .connect(sigc::mem_fun(
                *this,
                &NotesProgram::openFile
            ));

        saveButton.signal_clicked()
            .connect(sigc::mem_fun(
                *this,
                &NotesProgram::saveFile
            ));

        chooseFontButton.signal_clicked()
            .connect(sigc::mem_fun(
                *this,
                &NotesProgram::chooseFont
            ));

        biggerFontButton.signal_clicked()
            .connect(sigc::mem_fun(
                *this,
                &NotesProgram::increaseFont
            ));

        smallerFontButton.signal_clicked()
            .connect(sigc::mem_fun(
                *this,
                &NotesProgram::decreaseFont
            ));

        textField.get_buffer()
            ->signal_changed()
            .connect(sigc::mem_fun(
                *this,
                &NotesProgram::paintWords
            ));

        show_all_children();
    }
};

int main(int argc, char* argv[])
{
    auto app = Gtk::Application::create(
        argc,
        argv,
        "notes.program"
    );

    NotesProgram appWindow;

    return app->run(appWindow);
}
